# Copy to .env and fill in the values, or just run ./install.sh which creates
# this file and generates a password for you.

PUID=1000
PGID=1000
TZ=Etc/UTC

# HTTP basic auth for the desktop and the tunneled Pinokio UI.
# PASSWORD is required: without it the tunneled UI has no authentication.
CUSTOM_USER=abc
PASSWORD=change-me

TITLE=Pinokio

# Where Pinokio keeps its data (apps, models, environments). Can be huge.
CONFIG_PATH=./config

# Local network sharing for apps started in Pinokio. A single fixed port means
# only one app can share at a time; the image patches the proxy so a second
# app falls back to a free port instead of crashing Pinokio.
PINOKIO_SHARE_LOCAL=true
PINOKIO_SHARE_LOCAL_PORT=50000

# Tunnel (bore).
BORE_SERVER=bore.pub
# Public port to request from bore.pub. A fixed port keeps the URL stable
# across reconnects; 0 picks a random one.
BORE_PORT=0

# Image build settings.
BASE_IMAGE=joly0/pinokio-docker:latest
PINOKIO_IMAGE=pinokio-home:latest
# Pin a specific Pinokio release, e.g. 8.2.0. Empty = whatever the base ships.
PINOKIO_VERSION=
